<robot name="so100">
<!--Información de eslabones-->
<link name="base_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="Mallas/Base.STL" scale="1 1 1"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="shoulder_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <geometry>
            <mesh filename="Mallas/Shoulder_Rotation_Pitch.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="rojo">
            <color rgba="1 0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="upper_arm">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0.0 0.0"/>
        <geometry>
            <mesh filename="Mallas/Upper_Arm.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="amarillo">
            <color rgba="1 1 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="lower_arm">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0"/>
        <geometry>
            <mesh filename="Mallas/Lower_Arm.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="verde">
            <color rgba="0 1 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="wrist_pitch"><!--2.3562-->
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <!--rpy="2.30 0.0 3.141592"-->
        <geometry>
            <mesh filename="Mallas/Wrist_Pitch_Roll.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="blanco">
            <color rgba="1 1.0 1.0 1.0"/>
        </material>
    </visual>
</link>
<link name="fixed_gripper"><!--rpy="1.4 0.0 0.0" -->
    <visual>
        <origin xyz="0 0 0" rpy="0 -1.578 0"/>
        <geometry>
            <mesh filename="Mallas/Fixed_Gripper.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="cian">
            <color rgba="0 1 1 1.0"/>
        </material>
    </visual>
</link>
<link name="moving_jaw">
    <visual>
        <origin xyz="0 0 0" rpy="0 1.578 0"/>
        <geometry>
            <mesh filename="Mallas/Moving_Jaw.STL" scale="1.66 1 1"/>
        </geometry>
        <material name="magenta">
            <color rgba="1 0 1 1.0"/>
        </material>
    </visual>
</link>


<!--Información de articulaciones-->

<!-- las articulaciones van en orden así:
    base->shoulder rotation ->upper arm -> lower arm -> 
    wirst ptch roll -> fixed gripper -> moving jaw -->


<joint name="shoulder_joint" type="revolute">
    <origin xyz="0.0 -0.045 0.016" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-1.745" upper="1.745" effort="1.0" velocity="10.0"/>
</joint>

<joint name="upper_arm_joint" type="revolute">
    <origin xyz="0.0 -0.03 0.1" rpy="0.0 0.0 0.0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm"/>
    <axis xyz="1.0 0.0 0"/>
    <limit lower="-.1745" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>

<joint name="lower_arm_joint" type="revolute">
    <origin xyz="0.0 0.11 0.03" rpy="0.0 0.0 0.0"/>
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <axis xyz="1.0 0.0 0"/>
    <limit lower="-3.14" upper="0" effort="1.0" velocity="10.0"/>
</joint>

<joint name="wirst_pitch_joint" type="revolute">
    <origin xyz="0.0 -0.133 0.005" rpy=".7854 0.0 0.0"/>
    <parent link="lower_arm"/>
    <child link="wrist_pitch"/>
    <axis xyz="-1.0 0.0 0"/>
    <limit lower="-1" upper="2.7" effort="1.0" velocity="10.0"/>
</joint>

<joint name="fixed_gripper_joint" type="revolute">
    <origin xyz="0.0 -.061 0.0" rpy="0 0 0"/>
    <parent link="wrist_pitch"/>
    <child link="fixed_gripper"/>
    <axis xyz="0 1 0"/>  <!-- este es el eje desde la REFERENCIA DEL HIJO-->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>

<joint name="moving_jaw_joint" type="revolute">
    <origin xyz="0 -.025 -.034" rpy="0.0 0.0 0.0"/>
    <parent link="fixed_gripper"/>
    <child link="moving_jaw"/>
    <axis xyz="1 0 0"/>
    <limit lower="-.4014" upper="1.57" effort="1.0" velocity="10.0"/>
</joint>


</robot>